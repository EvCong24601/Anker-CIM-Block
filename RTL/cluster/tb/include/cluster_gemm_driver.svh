// Matrix loading and physical packing checks are distinct from DUT checks.
task automatic load_gemm_vectors();
  int fd, status, n0, k0;
  longint signed dot, wsum, centered;
  if (!$value$plusargs("GEMM_DATA_DIR=%s", data_dir))
    $fatal(1, "GEMM: require +GEMM_DATA_DIR=PATH generated by gemm_vectors.py");
  fd = $fopen({data_dir, "/requant_params.txt"}, "r");
  if (!fd) $fatal(1, "GEMM: cannot open parameter file");
  status = $fscanf(fd, "%d %d %d %d", multiplier, shift, output_zp, act_zp);
  $fclose(fd);
  if (status != 4 || act_zp == 0 || shift < -31 || shift > 31)
    $fatal(1, "GEMM: invalid parameters or missing asymmetric ACT zero point");
  $readmemh({data_dir, "/x_q.hex"}, x_q);
  $readmemh({data_dir, "/w_q.hex"}, w_q);
  $readmemh({data_dir, "/raw_golden.hex"}, raw_golden);
  $readmemh({data_dir, "/centered_golden.hex"}, centered_golden);
  $readmemh({data_dir, "/quant_golden.hex"}, quant_golden);
  $readmemh({data_dir, "/requant_zp.hex"}, zp);
  if ($test$plusargs("PER_CHANNEL_SCALE")) begin
    $readmemh({data_dir, "/requant_multiplier.hex"}, channel_multiplier);
    $readmemh({data_dir, "/requant_shift.hex"}, channel_shift);
  end
  $readmemh({data_dir, "/weight_rows.hex"}, weight_rows);
  $readmemh({data_dir, "/act_planes.hex"}, act_planes);
  // Independent unpacked matrix dot products catch a common packing error in
  // generated physical rows/planes rather than sharing their interpretation.
  for (int m = 0; m < M; m++)
    for (int n = 0; n < N; n++) begin
      dot  = 0;
      wsum = 0;
      for (int k = 0; k < K; k++) begin
        dot += longint'($signed(x_q[m*K+k])) * longint'($signed(w_q[k*N+n]));
        wsum += longint'($signed(w_q[k*N+n]));
      end
      centered = dot - longint'(act_zp) * wsum;
      if (raw_golden[m*N+n] !== 32'(dot) || centered_golden[m*N+n] !== 32'(centered))
        $fatal(1, "GEMM: Python/SV unpacked matrix golden mismatch m=%0d n=%0d", m, n);
    end
  requant_cfg_i[0] = '0;
  for (int tile = 0; tile < N_TILES; tile++) begin
    for (int macro = 0; macro < 8; macro++) begin
      k0 = 32 * macro;
      n0 = 4 * tile;
      for (int oc = 0; oc < 4; oc++)
      for (int j = 0; j < 32; j++)
      if (weight_rows[8*tile+macro][256*oc+8*j+:8] !== ((k0 + j < K) ? w_q[(k0+j)*N+n0+oc] : 8'b0))
        $fatal(1, "GEMM: weight packing mismatch tile=%0d macro=%0d oc=%0d k=%0d", tile, macro, oc, j);
    end
  end
  for (int m = 0; m < M; m++)
    for (int ph = 0; ph < 4; ph++) begin
      for (int k = 0; k < K; k++)
      if (act_planes[4*m+ph][4*k+:4] !== x_q[m*K+k][4*ph+:4])
        $fatal(1, "GEMM: ACT packing mismatch row=%0d slice=%0d k=%0d", m, ph, k);
      if (act_planes[4*m+ph][1023:512] !== 0) $fatal(1, "GEMM: unused ACT slots must be zero");
    end
endtask

// Preload four N4 tiles into rows 0x40..0x43 of the SAME eight Macros.
// Selecting a new row at the next batch changes N without reloading SRAM.
task automatic load_gemm_weights();
  for (int tile = 0; tile < N_TILES; tile++)
    for (int macro = 0; macro < 8; macro++) begin
      @(negedge clock);
      sram_row_addr = WEIGHT_ADDR + 8'(tile);
      sram_cs_en = 1;
      sram_wr_en = 1;
      sram_macro_group = 1'(macro / 4);
      sram_bank_sel = 2'(macro % 4);
      sram_wrdata[0] = weight_rows[8*tile+macro];
      $display(
        "[WEIGHT_WRITE] time=%0.3f ns description=load-single-cluster-N-tile tile=%0d macro=%0d address=0x%02h k=%0d..%0d",
        $realtime, tile, macro, sram_row_addr, 32 * macro, 32 * macro + 31);
    end
  @(negedge clock);
  sram_wr_en = 0;
  for (int tile = 0; tile < N_TILES; tile++)
    for (int macro = 0; macro < 8; macro++) begin
      sram_row_addr = WEIGHT_ADDR + 8'(tile);
      sram_macro_group = 1'(macro / 4);
      sram_bank_sel = 2'(macro % 4);
      @(posedge clock);
      #1;
      if (!sram_rd_valid[0] || sram_rd_data[0] !== weight_rows[8*tile+macro])
        $fatal(1, "GEMM: weight readback mismatch tile=%0d macro=%0d", tile, macro);
      @(negedge clock);
    end
  sram_cs_en = 0;
endtask

task automatic send_gemm_rows(input int tile);
  requant_cfg_i[0] = '0;
  requant_cfg_i[0].requant_multiplier = 32'(multiplier);
  requant_cfg_i[0].requant_shift = 10'(shift);
  if ($test$plusargs("PER_CHANNEL_SCALE")) begin
    requant_cfg_i[0].conv_mode = 1;
    requant_cfg_i[0].requant_mode = 1;
    for (int oc = 0; oc < 4; oc++) begin
      requant_cfg_i[0].requant_multiplier[32*oc+:32] = channel_multiplier[4*tile+oc];
      requant_cfg_i[0].requant_shift[10*oc+:10] = channel_shift[4*tile+oc];
    end
  end
  for (int lane = 0; lane < 4; lane++) begin
    requant_cfg_i[0].requant_zp[32*lane+:32] = zp[4*tile+lane];
  end
  cmd_i = '0;
  cmd_i.cim_os_cnt = 1;
  cmd_i.cim_ws_cnt = 32;
  cmd_i.cim_as_cnt = 1;
  cmd_i.cim_precision = 6;
  cmd_i.cim_signed_en = 1;
  cmd_i.cim_reduce_split_mask = 7'h00;
  cmd_i.cim_macro_en_mask = 8'hff;
  cmd_i.cim_macro_oc_mask = 32'hffffffff;
  cmd_i.cim_weight_raddr = WEIGHT_ADDR + 8'(tile);
  cmd_i.cim_act_slot_sel = 24'hfac688;
  for (int m = 0; m < M; m++) begin
    @(negedge clock);
    cmd_valid_i = 1;
    act_data_i  = act_planes[4*m];
    $display(
      "[CMD_SEND] time=%0.3f ns description=WS-GEMM-row tile=%0d row=%0d address=0x%02h os=1 ws=32 as=1 split=0x00 slots=0xfac688",
      $realtime, tile, m, cmd_i.cim_weight_raddr);
    @(posedge clock);
    if (cmd_ready_o !== 1'b1) $fatal(1, "GEMM: Command was not accepted by the single Cluster");
    #1;
    for (int ph = 1; ph < 4; ph++) begin
      @(negedge clock);
      cmd_valid_i = 0;
      act_data_i  = act_planes[4*m+ph];
      @(posedge clock);
      #1;
    end
    // Fifth cycle consumes the final registered Plane. No next-packet load
    // may overwrite this bank; the next row's A0 arrives one edge later.
    @(negedge clock);
    cmd_valid_i = 0;
    act_data_i  = '1;
    @(posedge clock);
    #1;
  end
endtask
